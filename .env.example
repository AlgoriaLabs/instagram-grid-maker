# The settings npm run dev and the other scripts read. Copy this file to .env and fill it in; .env stays out of git.
# No Stellar secret key goes here, or anywhere else in this project.

# The account clients pay, in USDC: a public G... address in your own wallet. Leave it empty: ./deploy.sh (provider-kit launch)
# sets one up in your wallet. Mainnet has no throwaway accounts.
PAY_TO=
# Where clients reach this service on this computer. ./deploy.sh sets the public one on the VM (https://<ip>.sslip.io).
PUBLIC_ORIGIN=http://localhost:8787
# The job database: paid jobs live here, so keep it on a disk that survives restarts.
JOB_DB_PATH=./jobs.sqlite
# Your Stellar 8004 agent id: ./deploy.sh (provider-kit launch) saves it.
AGENT_ID=
# The network: stellar:testnet takes test money, stellar:pubnet is mainnet, real USDC.
STELLAR_NETWORK=stellar:pubnet

# Mainnet's facilitator settles payments with an API key: get one at https://channels.openzeppelin.com/gen, and write it here
# as "Bearer <key>". ./deploy.sh copies it, and SOROBAN_RPC_URL, to the VM only (deploy/app.env, mode 600).
FACILITATOR_AUTH=
# A Soroban RPC, to decide uncertain payments from the chain: mainnet has no default. This is the one the Stellar
# 8004 SDK uses; for production traffic, a provider's is safer: https://developers.stellar.org/docs/data/apis/rpc/providers
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com

# What one make-grid call costs, in USDC. Default 0.01.
GRID_PRICE_USDC=0.01
